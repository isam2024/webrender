# Build container for shotwright on glibc Linux.
#
# Why AlmaLinux 8 (el8):
#   - glibc 2.28 — the lowest glibc we can reasonably target. Runs on:
#       * AlmaLinux 8 / Rocky 8 / RHEL 8 / CentOS 8
#       * AlmaLinux 9 / Rocky 9 / RHEL 9 (forward compat from 2.28 to 2.34)
#       * Ubuntu 20.04+, Debian 11+
#       * CloudLinux 8 — covers a huge slice of cheap cPanel hosting
#   - Modern Python 3.11 + GCC 12 are available via AppStream module / SCL,
#     so we don't need to bootstrap them from source.
#
# The image produces /out/shotwright plus /out/fonts. The PHP wrapper expects
# this layout.

FROM almalinux:8 AS builder

ARG TARGET=x86_64-unknown-linux-gnu
ARG RUST_VERSION=1.94.1

ENV PATH=/root/.cargo/bin:/opt/rh/gcc-toolset-12/root/usr/bin:$PATH \
    CARGO_NET_RETRY=10 \
    # Fully serialized C++ to fit comfortably in any CI runner. Override
    # via Dockerfile arg / env when building on a fat host.
    MAKEFLAGS=-j1 \
    MOZ_PARALLEL_BUILD=1 \
    CARGO_BUILD_JOBS=1

# Servo + mozjs build dependencies on AlmaLinux 8.
# - gcc-toolset-12: modern g++/gcc (stock el8 has gcc 8 which is too old)
# - llvm-toolset: clang for bindgen
# - python3.11: TypeGuard etc. (stock el8 has 3.6)
# - autoconf213: legacy autoconf for SpiderMonkey
RUN dnf install -y dnf-plugins-core epel-release && \
    dnf config-manager --set-enabled powertools && \
    dnf install -y \
        ca-certificates curl xz file pkgconf-pkg-config which \
        gcc-toolset-12 gcc-toolset-12-libstdc++-devel \
        llvm-toolset \
        cmake ninja-build make \
        autoconf213 automake libtool m4 \
        python3.11 python3.11-devel python3.11-pip \
        perl perl-FindBin perl-File-Compare \
        fontconfig-devel freetype-devel harfbuzz-devel \
        openssl-devel zlib-devel bzip2-devel libffi-devel \
        mesa-libGL-devel mesa-libEGL-devel \
        libxcb-devel libX11-devel \
        dbus-devel \
        glibc-devel binutils \
    && dnf clean all && rm -rf /var/cache/dnf

# Make python3.11 the default `python3` and `python` for build scripts.
RUN ln -sf /usr/bin/python3.11 /usr/local/bin/python3 && \
    ln -sf /usr/bin/python3.11 /usr/local/bin/python && \
    python3 --version

# Activate gcc-toolset-12 + clang for the rest of the build. We also export
# CC/CXX so cargo's cc-rs picks up the right compilers.
ENV CC=/opt/rh/gcc-toolset-12/root/usr/bin/gcc \
    CXX=/opt/rh/gcc-toolset-12/root/usr/bin/g++ \
    LD_LIBRARY_PATH=/opt/rh/gcc-toolset-12/root/usr/lib64

# Rust toolchain via rustup, pinned.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --profile minimal --default-toolchain ${RUST_VERSION} && \
    rustup target add ${TARGET}

WORKDIR /src

# Two-stage build for cache friendliness:
#   1. Compile every dependency against a stub main.rs (the slow ~60 min part).
#      Invalidated only when Cargo.toml / Cargo.lock change.
#   2. Compile our own src/. Invalidated whenever main.rs or render.rs change.

COPY Cargo.toml Cargo.lock* ./
RUN mkdir -p src && \
    printf 'fn main() {}\n' > src/main.rs && \
    printf '\n' > src/render.rs && \
    cargo build --release --target ${TARGET} --bin shotwright && \
    rm -f /src/target/${TARGET}/release/shotwright \
          /src/target/${TARGET}/release/deps/shotwright-* \
          /src/target/${TARGET}/release/deps/shotwright_engine-* && \
    rm -rf src

COPY src ./src
RUN cargo build --release --target ${TARGET} --bin shotwright && \
    install -d /out && \
    install -m 0755 /src/target/${TARGET}/release/shotwright /out/shotwright && \
    (strip /out/shotwright || echo "strip skipped")

# Stage the fonts a screenshot tool actually needs in a "no system fonts" host.
# DejaVu covers Latin/Greek/Cyrillic/IPA. Noto + Noto CJK + Noto Emoji cover
# the rest of the legible web. Anything else falls back gracefully.
RUN dnf install -y \
        dejavu-sans-fonts dejavu-serif-fonts dejavu-sans-mono-fonts \
        google-noto-sans-fonts google-noto-serif-fonts \
        google-noto-sans-cjk-ttc-fonts google-noto-serif-cjk-ttc-fonts \
        google-noto-emoji-fonts google-noto-emoji-color-fonts \
    && dnf clean all && \
    install -d /out/fonts && \
    cp -r /usr/share/fonts/dejavu /out/fonts/ 2>/dev/null || true && \
    cp -r /usr/share/fonts/google-noto* /out/fonts/ 2>/dev/null || true

# Final stage: just the artifacts.
FROM scratch AS artifact
COPY --from=builder /out /out
