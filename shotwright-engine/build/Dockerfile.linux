# Build container for shotwright on glibc Linux.
#
# Why Ubuntu 22.04 (jammy):
#   - This is Servo's primary CI target — toolchain alignment is the most
#     battle-tested combination for SpiderMonkey + WebRender.
#   - Python 3.10 is the system default (TypeGuard available; no source build).
#   - clang 14 + gcc 11 align cleanly with mozjs's bindgen invocation.
#   - glibc 2.35 — works on Ubuntu 22.04+ and AlmaLinux 10+ / RHEL 10+.
#     Note: this excludes AlmaLinux 9 / RHEL 9 (glibc 2.34); for those, build
#     a separate variant from a glibc 2.31 base.
#
# The image produces /out/shotwright plus /out/fonts. The PHP wrapper expects
# this layout.

FROM ubuntu:22.04 AS builder

ARG TARGET=x86_64-unknown-linux-gnu
ARG RUST_VERSION=1.94.1

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/root/.cargo/bin:$PATH \
    CARGO_NET_RETRY=10 \
    # Fully serialized so peak C++ memory is one cc1plus (~4 GB) and the
    # build container stays inside its --memory cap. Slow but predictable.
    MAKEFLAGS=-j1 \
    MOZ_PARALLEL_BUILD=1 \
    CARGO_BUILD_JOBS=1

# Servo + mozjs build dependencies. autoconf-2.13 is required by mozjs's
# legacy SpiderMonkey build scripts.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl xz-utils file pkg-config \
        build-essential clang libclang-dev llvm \
        cmake ninja-build \
        autoconf2.13 automake libtool m4 \
        python3 python3-pip python3-distutils-extra \
        perl \
        libfontconfig1-dev libfreetype6-dev libharfbuzz-dev \
        libssl-dev zlib1g-dev libbz2-dev libffi-dev \
        libgl1-mesa-dev libegl1-mesa-dev libgles2-mesa-dev \
        libxcb1-dev libx11-xcb-dev \
        libdbus-1-dev \
    && rm -rf /var/lib/apt/lists/* && \
    python3 --version

# Rust toolchain via rustup, pinned.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --profile minimal --default-toolchain ${RUST_VERSION} && \
    rustup target add ${TARGET}

WORKDIR /src

# Two-stage build for cache friendliness:
#   1. Compile every dependency against a stub main.rs (the slow ~60 min part).
#      This layer is invalidated only when Cargo.toml / Cargo.lock change.
#   2. Compile our own src/. Invalidated whenever main.rs or render.rs change.
# Without this split, every src/ tweak forces a full SpiderMonkey rebuild.

COPY Cargo.toml Cargo.lock* ./
RUN mkdir -p src && \
    printf 'fn main() {}\n' > src/main.rs && \
    printf '\n' > src/render.rs && \
    cargo build --release --target ${TARGET} --bin shotwright && \
    rm -f /src/target/${TARGET}/release/shotwright \
          /src/target/${TARGET}/release/deps/shotwright-* \
          /src/target/${TARGET}/release/deps/shotwright_engine-* && \
    rm -rf src

COPY src ./src
RUN cargo build --release --target ${TARGET} --bin shotwright && \
    install -d /out && \
    install -m 0755 /src/target/${TARGET}/release/shotwright /out/shotwright && \
    (strip /out/shotwright || echo "strip skipped")

# Stage the fonts a screenshot tool actually needs in a "no system fonts" host.
# DejaVu covers Latin/Greek/Cyrillic/IPA. Noto CJK + Noto Color Emoji cover
# the rest of the legible web. Anything else falls back gracefully.
RUN apt-get update && apt-get install -y --no-install-recommends \
        fonts-dejavu-core fonts-noto-core fonts-noto-cjk-extra fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/* && \
    install -d /out/fonts && \
    cp -r /usr/share/fonts/truetype/dejavu /out/fonts/ && \
    cp -r /usr/share/fonts/truetype/noto /out/fonts/ 2>/dev/null || true && \
    cp -r /usr/share/fonts/opentype/noto /out/fonts/noto-otf 2>/dev/null || true && \
    cp -r /usr/share/fonts/truetype/noto-cjk /out/fonts/ 2>/dev/null || true

# Final stage: just the artifacts.
FROM scratch AS artifact
COPY --from=builder /out /out
