{
    "name": "shotwright/shotwright",
    "description": "Self-hosted PHP screenshot library for shared hosting. Wraps the shotwright binary (Servo-based) — no Chromium, no Node, no display server.",
    "type": "library",
    "license": "MPL-2.0",
    "keywords": ["screenshot", "headless", "browser", "png", "url-to-image", "shared-hosting", "cpanel", "servo"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Shotwright\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shotwright\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/shotwright-install"
    ],
    "scripts": {
        "test": "phpunit"
    }
}
